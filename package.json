{
  "name": "extralife-helper-bot",
  "version": "4.4.0",
  "description": "A unified helper bot for managing ExtraLife 24 hour marathon streams, bridging between Discord and Twitch",
  "main": "app.js",
  "scripts": {
    "analyze": "node scripts/analyze.js",
    "lint": "eslint .",
    "test": "jest --config jest.config.json",
    "test:watch": "npm test -- --watch",
    "test:coverage": "npm test -- --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "start": "node app.js",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stjohnjohnson/extralife-helper-bot.git"
  },
  "author": "St. John Johnson <st.john.johnson@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "bugs": {
    "url": "https://github.com/stjohnjohnson/extralife-helper-bot/issues"
  },
  "homepage": "https://github.com/stjohnjohnson/extralife-helper-bot#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.2",
    "extra-life-api": "^8.0.0",
    "node-hue-api": "^5.0.0-beta.16",
    "tmi.js": "^1.8.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jest": "^30.5.2",
    "semantic-release": "^24.2.0"
  },
  "keywords": []
}
