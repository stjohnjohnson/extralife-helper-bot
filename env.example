# Example environment variables for ExtraLife Helper Bot
# Copy this file to .env and fill in your values

# Required - Your ExtraLife participant ID
EXTRALIFE_PARTICIPANT_ID=your_participant_id_here

# Discord Configuration (optional - remove if not using Discord)
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_DONATION_CHANNEL=your_donation_channel_id_here
DISCORD_SUMMARY_CHANNEL=your_summary_channel_id_here

# Discord Voice Channel Management (optional - for !promote command)
DISCORD_WAITING_ROOM_CHANNEL=voice_channel_id_for_waiting_room
DISCORD_LIVE_ROOM_CHANNEL=voice_channel_id_for_live_chat

# Admin Users (optional - for restricted commands like !promote)
DISCORD_ADMIN_USERS=your_discord_user_id,another_admin_user_id
TWITCH_ADMIN_USERS=your_twitch_username,another_admin_username

# Twitch Configuration (optional - remove if not using Twitch)
TWITCH_USERNAME=your_bot_username_here
TWITCH_CHAT_OAUTH=oauth:bot_chat_token_here
TWITCH_CHANNEL=your_channel_name_here
TWITCH_CLIENT_ID=your_twitch_app_client_id_here

# Game Update Notifications (optional - requires Discord + Twitch + these tokens)
DISCORD_GAME_UPDATE_USER_ID=discord_user_id_to_monitor_for_game_changes
DISCORD_GAME_UPDATE_MESSAGE=Streamer is now playing {game}!
TWITCH_CLIENT_SECRET=your_twitch_app_client_secret_here
TWITCH_REFRESH_TOKEN=your_refresh_token_here

# Custom Command Responses (optional)
# Format: command1:"response1",command2:"response2"
# Example: CUSTOM_RESPONSES=donate:"Check out my donation link: https://donate.example.com",discord:"Join our Discord: https://discord.gg/example"
CUSTOM_RESPONSES=

# Philips Hue Configuration (required - for celebration light shows on donations)
HUE_USERNAME=your_hue_bridge_username_here
HUE_IPADDRESS=your_hue_bridge_ip_address_here
HUE_GROUPID=your_hue_group_id_here

# Optional - lets all Twitch and Discord users control the same Hue group with !color
# Parties restore their previous state; donation celebrations cancel active parties
HUE_CHAT_CONTROL_ENABLED=false

# Analytics sampling cadence (integer seconds, 15–3600)
TWITCH_VIEWER_SAMPLE_INTERVAL_SECONDS=60
DISCORD_VOICE_SAMPLE_INTERVAL_SECONDS=60

# Optional LAN OBS voice overlay (target and helper avatars excluded)
# Helper joins only while DISCORD_GAME_UPDATE_USER_ID is in DISCORD_LIVE_ROOM_CHANNEL
VOICE_OVERLAY_ENABLED=false
VOICE_OVERLAY_HOST=0.0.0.0
VOICE_OVERLAY_PORT=3000

# Optional Twitch markers for large Extra Life donations (USD, inclusive threshold)
# Blank/unset disables markers. Example: 100 marks donations of $100.00 or more.
# Requires the broadcaster token above with channel:manage:broadcast and VOD storage.
STREAM_MARKER_DONATION_THRESHOLD=

# Optional Stream Avatars LAN bridge; invalid settings disable only this integration
STREAM_AVATARS_ENABLED=false
STREAM_AVATARS_HOST=0.0.0.0
STREAM_AVATARS_PORT=3001
# Generate a private random token (16–256 characters); never put it in chat or URLs
STREAM_AVATARS_TOKEN=
STREAM_AVATARS_STATE_DIR=./data/stream-avatars
STREAM_AVATARS_OFFLINE_GRACE_SECONDS=900
# Measure these in Stream Avatars coordinates, before OBS crop/scaling
STREAM_AVATARS_STRIP_X=0
STREAM_AVATARS_STRIP_Y=0
STREAM_AVATARS_STRIP_WIDTH=
STREAM_AVATARS_STRIP_HEIGHT=
STREAM_AVATARS_MAX_HEARTS=50
STREAM_AVATARS_HEART_OFFSET=16
